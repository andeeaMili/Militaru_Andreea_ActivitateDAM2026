<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/etAdministrator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nume administrator"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/etDenumire"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Denumire amanet"
            android:inputType="text" />

        <EditText
            android:id="@+id/etLocatie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Locatie"
            android:inputType="text" />

        <CheckBox
            android:id="@+id/cbFideli"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clienti fideli" />

        <EditText
            android:id="@+id/etNrObiecte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Numar obiecte"
            android:inputType="number" />

        <EditText
            android:id="@+id/etProfit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Profit luna anterioara"
            android:inputType="numberDecimal|numberSigned" />

        <Button
            android:id="@+id/btnSalveaza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salveaza"
            android:onClick="culegeInfo"
            android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>
