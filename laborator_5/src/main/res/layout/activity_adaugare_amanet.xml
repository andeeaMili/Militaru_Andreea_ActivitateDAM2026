<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".adaugare_amanet">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hello World!"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <EditText
        android:id="@+id/nume_AM"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/introduceti_numele"
        android:inputType="text"
        />
    <CheckBox
        android:id="@+id/eStudent_CB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/esti_client_fidel" />
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="culegeInfo"
        android:text="@string/apasa" />
<RadioButton
    android:id="@+id/am_rbtn"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Eur"
    android:checked="true"
    />

    <Spinner
        android:id="@+id/am_sp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        />
    <RatingBar
        android:id="@+id/am_rb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:stepSize="0.5"
        />
    <Switch
        android:id="@+id/am_sw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vinzi_cumperi"
        />
</LinearLayout>